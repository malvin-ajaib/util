# Copy this file to .env and fill in the values.

# JWT auth token. With or without the leading "jwt " prefix.
TOKEN=

# Cutoff date (YYYY-MM-DD). Pagination stops once a page's oldest
# object is before this date.
CUTOFF=2026-07-09

# --- optional (defaults shown) ---
# Delay between requests, seconds
DELAY=0.2
# Safety ceiling on number of pages
MAX_PAGES=1000
# Drop objects older than CUTOFF from the final dump. Set to 0 to keep them.
STRICT=1
